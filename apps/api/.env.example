# Prefer loading from repo root `.env`. Local overrides:
PORT=3011
DATABASE_URL=postgresql://trescielos:localdev@localhost:5440/trescielos_dev?schema=public
REDIS_URL=redis://localhost:6390
CORS_ORIGINS=http://localhost:3010
QUEUE_DRIVER=inline

JWT_SECRET=dev-only-change-me-not-for-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@trescielos.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# --- AI providers (docs/backend/07 §4) ---
# fake = smoke/CI sin keys; live = OpenAI (COHERE_API_KEY opcional; S3 si STORAGE_PROVIDER ≠ memory)
AI_PROVIDERS_MODE=fake
# v2 = default (captura agrupada + piso $250k). v3 = conversión visita.
# Canary: con v2, CONVERSATION_FLOW_CANARY_PCT=10 asigna v3 al 10% de hilos (hash sede/hilo).
CONVERSATION_FLOW=v2
CONVERSATION_FLOW_CANARY_PCT=0

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_MODEL_ORCHESTRATOR=gpt-4.1-mini
OPENAI_MODEL_GENERATOR=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MODEL_VISION=gpt-4.1-mini
OPENAI_WHISPER_MODEL=whisper-1

COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
RERANK_THRESHOLD=0.85
RERANK_TOP_N=15
RERANK_TOP_K_LLM=4

AI_MAX_TOKENS_ORCHESTRATOR=1024
AI_MAX_TOKENS_GENERATOR=800
AI_MAX_INPUT_CHARS_RAG=12000
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

CUPO_MENSUAL_MENSAJES=1000
CUPO_AI_TOKENS_SOFT_LIMIT=
CUPO_AI_TOKENS_HARD_LIMIT=

# Object storage (memory = fake in-process; s3 = AWS o MinIO)
# Staging/prod: STORAGE_PROVIDER=s3 y S3_BUCKET obligatorio. S3_ENDPOINT vacío = AWS real.
STORAGE_PROVIDER=memory
OBJECT_STORAGE_FS_ROOT=./data/object-storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=trescielos-media
S3_ACCESS_KEY_ID=trescielos
S3_SECRET_ACCESS_KEY=localdevminio
STORAGE_PUBLIC_BASE_URL=
RAG_STORE=memory
FETCH_CHANNEL_MEDIA=0

# Cupo Fase F (soft/hard → handoff cupo_ia)
QUOTA_MSG_SOFT=800
QUOTA_MSG_HARD=1000
QUOTA_AI_TOKENS_SOFT=200000
QUOTA_AI_TOKENS_HARD=250000

# Canales — webhooks por firma (NUNCA JWT panel)
APP_ENV=dev
META_APP_SECRET=
META_VERIFY_TOKEN=tres-cielos-dev-verify
META_PAGE_ACCESS_TOKEN=
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=http://localhost:3011/webhooks/twilio/whatsapp

# Content SID de Twilio (plantillas v2: B1 quick-reply, B2 list-picker, B3 sí/no)
TWILIO_CONTENT_SID_GUION_NOMBRE_FECHA=
TWILIO_CONTENT_SID_GUION_AFORO_INVERSION=
TWILIO_CONTENT_SID_GUION_ACLARACION_PISO=

# Sandbox chat (mismo pipeline que Twilio, sin firma). APP_ENV=dev|test|staging o:
ORCHESTRATOR_TURN_TOKEN=
