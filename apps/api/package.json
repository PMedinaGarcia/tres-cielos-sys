{
  "name": "@tres-cielos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:rag": "jest --config jest.config.js --testPathPatterns=\"rag\" --testPathPatterns=\"fixtures/knowledge\"",
    "test:orchestrator": "jest --config jest.config.js --testPathPatterns=conversation --testPathPatterns=tools-catalog --testPathPatterns=orchestrator-turn",
    "lint": "echo \"no lint yet\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "sandbox:seed": "ts-node --transpile-only src/catalog-sandbox/seed.ts",
    "sandbox:eval": "ts-node --transpile-only src/catalog-sandbox/eval.ts",
    "sandbox:xlsx": "ts-node --transpile-only src/catalog-sandbox/generate-xlsx.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@nestjs/common": "^11.0.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.7",
    "@nestjs/platform-express": "^11.0.7",
    "@prisma/client": "^6.3.0",
    "@tres-cielos/shared": "workspace:*",
    "chrono-node": "^2.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cohere-ai": "^8.0.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.2",
    "openai": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "jest": "^30.4.2",
    "prisma": "^6.3.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
