generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identidad de panel ─────────────────────────────────────────────────────

enum RolUsuario {
  asesor
  coordinador
  admin
}

model Organizacion {
  id             String   @id @default(cuid())
  nombre         String
  activa         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")
  sedes          Sede[]
  usuarios       Usuario[]

  @@map("organizaciones")
}

model Sede {
  id              String        @id @default(cuid())
  organizacionId  String        @map("organizacion_id")
  organizacion    Organizacion  @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  nombre          String
  activa          Boolean       @default(true)
  zonaHoraria     String        @default("America/Mexico_City") @map("zona_horaria")
  creadoEn        DateTime      @default(now()) @map("creado_en")
  actualizadoEn   DateTime      @updatedAt @map("actualizado_en")
  usuarios         UsuarioSede[]
  clientesInteres  Cliente[]

  @@index([organizacionId])
  @@map("sedes")
}

model Usuario {
  id                 String         @id @default(cuid())
  organizacionId     String         @map("organizacion_id")
  organizacion       Organizacion   @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  email              String         @unique
  passwordHash       String         @map("password_hash")
  nombre             String
  rol                RolUsuario
  activo             Boolean        @default(true)
  disponible         Boolean        @default(true)
  passwordChangedAt  DateTime?      @map("password_changed_at")
  creadoEn           DateTime       @default(now()) @map("creado_en")
  actualizadoEn      DateTime       @updatedAt @map("actualizado_en")
  sedes                    UsuarioSede[]
  refreshTokens            RefreshToken[]
  clientesAsignados        Cliente[]      @relation("ClienteAsesor")
  oportunidadesAsignadas   Oportunidad[]  @relation("OportunidadAsesor")
  asignacionesDestino      Asignacion[]   @relation("AsignacionDestino")
  asignacionesActor        Asignacion[]   @relation("AsignacionActor")
  notasCliente             NotaCliente[]

  @@index([organizacionId])
  @@index([rol, activo])
  @@map("usuarios")
}

model UsuarioSede {
  usuarioId  String  @map("usuario_id")
  usuario    Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sedeId     String  @map("sede_id")
  sede       Sede    @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, sedeId])
  @@index([sedeId])
  @@map("usuario_sedes")
}

model RefreshToken {
  id         String    @id @default(cuid())
  usuarioId  String    @map("usuario_id")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  creadoEn   DateTime  @default(now()) @map("creado_en")

  @@index([usuarioId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── Catálogo sandbox (existente — no romper) ───────────────────────────────

