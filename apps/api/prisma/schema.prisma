model Paquete {
  id                String             @id @default(cuid())
  codigoSku         String             @unique @map("codigo_sku")
  nombre            String
  tipoEvento        TipoEvento         @map("tipo_evento")
  sede              String?
  aforoMin          Int                @map("aforo_min")
  aforoMax          Int                @map("aforo_max")
  descripcionCorta  String?            @map("descripcion_corta")
  estado            EstadoPublicacion  @default(publicado)
  version           Int                @default(1)
  creadoEn          DateTime           @default(now()) @map("creado_en")
  actualizadoEn     DateTime           @updatedAt @map("actualizado_en")
  precios           PaquetePrecio[]
  inclusiones       PaqueteInclusion[]
  reglas            PaqueteRegla[]
  oportunidades    Oportunidad[]      @relation("PaqueteTentativo")

  @@map("paquetes")
}

model PaquetePrecio {
  id            String            @id @default(cuid())
  paqueteId     String            @map("paquete_id")
  paquete       Paquete           @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  moneda        String            @default("MXN")
  monto         Float?
  rangoMin      Float?            @map("rango_min")
  rangoMax      Float?            @map("rango_max")
  unidad        UnidadPrecio      @default(evento)
  vigenteDesde  DateTime          @map("vigente_desde")
  vigenteHasta  DateTime?         @map("vigente_hasta")
  condiciones   String?
  estado        EstadoPublicacion @default(publicado)

  @@index([paqueteId])
  @@map("paquete_precios")
}

model PaqueteInclusion {
  id          String             @id @default(cuid())
  paqueteId   String             @map("paquete_id")
  paquete     Paquete            @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  categoria   CategoriaInclusion
  nombre      String
  cantidad    Float?
  unidad      String?
  obligatoria Boolean            @default(true)
  orden       Int                @default(0)

  @@index([paqueteId])
  @@map("paquete_inclusiones")
}

model PaqueteRegla {
  id                String    @id @default(cuid())
  paqueteId         String    @map("paquete_id")
  paquete           Paquete   @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  tipo              TipoRegla
  parametros        Json?     @map("parametros")
  mensajeProspecto  String?   @map("mensaje_prospecto")

  @@index([paqueteId])
  @@map("paquete_reglas")
}

model ImportacionCatalogo {
  id             String               @id @default(cuid())
  actor          String               @default("sandbox")
  archivo        String
  iniciadoEn     DateTime             @default(now()) @map("iniciado_en")
  terminadoEn    DateTime?            @map("terminado_en")
  filasOk        Int                  @default(0) @map("filas_ok")
  filasError     Int                  @default(0) @map("filas_error")
  detalleErrores Json?                @map("detalle_errores")
  resultado      ResultadoImportacion @default(exito)

  @@map("importaciones_catalogo")
}

// ─── CRM: Cliente canónico + expediente ─────────────────────────────────────

model Cliente {
  id                   String          @id @default(cuid())
  nombre               String?
  telefono             String?
  correo               String?
  nombrePerfilCanal    String?         @map("nombre_perfil_canal")
  estadoAtencion       EstadoAtencion  @default(nuevo) @map("estado_atencion")
  asesorAsignadoId     String?         @map("asesor_asignado_id")
  asesorAsignado       Usuario?        @relation("ClienteAsesor", fields: [asesorAsignadoId], references: [id], onDelete: SetNull)
  canalOrigen          Canal?          @map("canal_origen")
  fuenteAlta           FuenteAlta      @default(bot) @map("fuente_alta")
  origenJson           Json?           @map("origen_json")
  sedeInteresId        String?         @map("sede_interes_id")
  sedeInteres          Sede?           @relation(fields: [sedeInteresId], references: [id], onDelete: SetNull)
  idioma               String?         @default("es")
  zonaHoraria          String?         @map("zona_horaria")
  optOutMensajeria     Boolean         @default(false) @map("opt_out_mensajeria")
  fusionadoEnClienteId String?         @map("fusionado_en_cliente_id")
  fusionadoEn          Cliente?        @relation("ClienteFusion", fields: [fusionadoEnClienteId], references: [id], onDelete: SetNull)
  fusionados           Cliente[]       @relation("ClienteFusion")
  primerContactoEn     DateTime        @default(now()) @map("primer_contacto_en")
  ultimoContactoEn     DateTime        @default(now()) @map("ultimo_contacto_en")
  creadoEn             DateTime        @default(now()) @map("creado_en")
  actualizadoEn        DateTime        @updatedAt @map("actualizado_en")

  identificadores      IdentificadorCliente[]
  memoria              MemoriaCliente?
  seguimientos         SeguimientoProgramado[]
  tags                 ClienteTag[]
  notas                NotaCliente[]
  interacciones        Interaccion[]
  oportunidades        Oportunidad[]
  conversaciones       Conversacion[]
  eventosOperativos    EventoOperativo[]
  asignaciones         Asignacion[]

  @@index([telefono])
  @@index([correo])
  @@index([estadoAtencion])
  @@index([asesorAsignadoId])
  @@index([sedeInteresId])
  @@map("clientes")
}

/// Perfil canónico que el guion lee. El hilo de canal no es el dueño de los slots.
model MemoriaCliente {
  id                   String            @id @default(cuid())
  clienteId            String            @unique @map("cliente_id")
  cliente              Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  campos               Json              @default("{}")
  pasoGuion            PasoGuion         @default(saludo) @map("paso_guion")
  guionVersion         String?           @map("guion_version")
  rutaComercial        RutaComercial?    @map("ruta_comercial")
  estadoBot            EstadoBot         @default(activo) @map("estado_bot")
  resumen              String            @default("")
  resumenActualizadoEn DateTime?         @map("resumen_actualizado_en")
  ultimoTurnoEn        DateTime?         @map("ultimo_turno_en")
  oportunidadAbiertaId String?           @map("oportunidad_abierta_id")
  asesorLockId         String?           @map("asesor_lock_id")
  slaVenceEn           DateTime?         @map("sla_vence_en")
  cola                 String?
  motivoHandoff        MotivoHandoff?    @map("motivo_handoff")
  escaladoEn           DateTime?         @map("escalado_en")
  ultimaRuta           RutaOrquestador?  @map("ultima_ruta")
  paqueteTentativoId   String?           @map("paquete_tentativo_id")
  pedidoCotizacion     Boolean?          @map("pedido_cotizacion")
  pedidoCotizacionFuente String?         @map("pedido_cotizacion_fuente")
  creadoEn             DateTime          @default(now()) @map("creado_en")
  actualizadoEn        DateTime          @updatedAt @map("actualizado_en")

  @@index([estadoBot])
  @@index([oportunidadAbiertaId])
  @@map("memorias_cliente")
}

model SeguimientoProgramado {
  id             String           @id @default(cuid())
  clienteId      String           @map("cliente_id")
  cliente        Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  oportunidadId  String?          @map("oportunidad_id")
  conversacionId String?          @map("conversacion_id")
  tipo           TipoSeguimiento
  disparaEn      DateTime         @map("dispara_en")
  nombre         String?
  cancelado      Boolean          @default(false)
  disparadoEn    DateTime?        @map("disparado_en")
  creadoEn       DateTime         @default(now()) @map("creado_en")

  @@index([clienteId, cancelado])
  @@index([disparaEn, cancelado])
  @@map("seguimientos_programados")
}

model IdentificadorCliente {
  id               String                    @id @default(cuid())
  clienteId        String                    @map("cliente_id")
  cliente          Cliente                   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo             TipoIdentificadorCliente
  valor            String
  valorNormalizado String                    @map("valor_normalizado")
  creadoEn         DateTime                  @default(now()) @map("creado_en")

  @@unique([tipo, valorNormalizado])
  @@index([clienteId])
  @@map("identificadores_cliente")
}

model Tag {
  id        String       @id @default(cuid())
  nombre    String       @unique
  creadoEn  DateTime     @default(now()) @map("creado_en")
  clientes  ClienteTag[]

  @@map("tags")
}

model ClienteTag {
  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tagId     String  @map("tag_id")
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clienteId, tagId])
  @@index([tagId])
  @@map("cliente_tags")
}

model NotaCliente {
  id        String   @id @default(cuid())
  clienteId String   @map("cliente_id")
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  autorId   String   @map("autor_id")
  autor     Usuario  @relation(fields: [autorId], references: [id], onDelete: Restrict)
  cuerpo    String
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@index([clienteId, creadoEn])
  @@map("notas_cliente")
}

model Interaccion {
  id                String          @id @default(cuid())
  clienteId         String          @map("cliente_id")
  cliente           Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  oportunidadId     String?         @map("oportunidad_id")
  oportunidad       Oportunidad?    @relation(fields: [oportunidadId], references: [id], onDelete: SetNull)
  conversacionId    String?         @map("conversacion_id")
  conversacion      Conversacion?   @relation(fields: [conversacionId], references: [id], onDelete: SetNull)
  mensajeId         String?         @map("mensaje_id")
  mensaje           Mensaje?        @relation(fields: [mensajeId], references: [id], onDelete: SetNull)
  eventoOperativoId String?         @unique @map("evento_operativo_id")
  eventoOperativo   EventoOperativo? @relation(fields: [eventoOperativoId], references: [id], onDelete: SetNull)
  tipo              TipoInteraccion
  actor             ActorOperativo
  canal             Canal?
  resumen           String
  payload           Json            @default("{}")
  creadoEn          DateTime        @default(now()) @map("creado_en")

  @@index([clienteId, creadoEn])
  @@index([oportunidadId, creadoEn])
  @@map("interacciones")
}

model Asignacion {
  id               String          @id @default(cuid())
  clienteId        String          @map("cliente_id")
  cliente          Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  oportunidadId    String          @map("oportunidad_id")
  oportunidad      Oportunidad     @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  usuarioDestinoId String          @map("usuario_destino_id")
  usuarioDestino   Usuario         @relation("AsignacionDestino", fields: [usuarioDestinoId], references: [id], onDelete: Restrict)
  actor            ActorAsignacion @default(sistema)
  actorUsuarioId   String?         @map("actor_usuario_id")
  actorUsuario     Usuario?        @relation("AsignacionActor", fields: [actorUsuarioId], references: [id], onDelete: SetNull)
  regla            ReglaAsignacion
  vigente          Boolean         @default(true)
  motivo           String?
  creadoEn         DateTime        @default(now()) @map("creado_en")

  @@index([oportunidadId, vigente])
  @@index([clienteId])
  @@index([usuarioDestinoId])
  @@map("asignaciones")
}

model Oportunidad {
  id                 String                  @id @default(cuid())
  clienteId          String                  @map("cliente_id")
  cliente            Cliente                 @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipoEvento         TipoEvento?             @map("tipo_evento")
  fechaTentativa     DateTime?               @map("fecha_tentativa")
  fechaFlexible      Boolean                 @default(false) @map("fecha_flexible")
  aforo              Int?
  presupuestoNota    String?                 @map("presupuesto_nota")
  paqueteTentativoId String?                 @map("paquete_tentativo_id")
  paqueteTentativo   Paquete?                @relation("PaqueteTentativo", fields: [paqueteTentativoId], references: [id])
  aMedida            Boolean                 @default(false) @map("a_medida")
  calificacion       CalificacionOportunidad @default(en_exploracion)
  listoParaCotizar   Boolean                 @default(false) @map("listo_para_cotizar")
  etapa              EtapaPipeline           @default(nuevo_bot)
  motivoPerdido      MotivoPerdido?          @map("motivo_perdido")
  intencionVisita    Boolean                 @default(false) @map("intencion_visita")
  visitaEstado       VisitaEstado            @default(no_solicitada) @map("visita_estado")
  visitaAgendadaEn   DateTime?               @map("visita_agendada_en")
  visitaNotas        String?                 @map("visita_notas")
  propuestaEnviadaEn DateTime?               @map("propuesta_enviada_en")
  etapaCotizacion    EtapaCotizacion         @default(perfilando) @map("etapa_cotizacion")
  canalOrigen        Canal?                  @map("canal_origen")
  sede               String?
  briefJson          Json?                   @map("brief_json")
  asesorAsignadoId   String?                 @map("asesor_asignado_id")
  asesorAsignado     Usuario?                @relation("OportunidadAsesor", fields: [asesorAsignadoId], references: [id], onDelete: SetNull)
  creadoEn           DateTime                @default(now()) @map("creado_en")
  actualizadoEn      DateTime                @updatedAt @map("actualizado_en")
  conversaciones     Conversacion[]
  eventosOperativos  EventoOperativo[]
  interacciones      Interaccion[]
  asignaciones       Asignacion[]

  @@index([clienteId])
  @@index([etapa])
  @@index([asesorAsignadoId])
  @@index([visitaEstado])
  @@index([etapaCotizacion])
  @@map("oportunidades")
}

model Conversacion {
  id                   String           @id @default(cuid())
  clienteId            String           @map("cliente_id")
  cliente              Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  oportunidadId        String           @map("oportunidad_id")
  oportunidad          Oportunidad      @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  canal                Canal
  externalThreadId     String?          @map("external_thread_id")
  estadoBot            EstadoBot        @default(activo) @map("estado_bot")
  pasoGuion            PasoGuion        @default(saludo) @map("paso_guion")
  camposCapturados     Json?            @map("campos_capturados")
  paqueteTentativoId   String?          @map("paquete_tentativo_id")
  ultimaRuta           RutaOrquestador? @map("ultima_ruta")
  motivoHandoff        MotivoHandoff?   @map("motivo_handoff")
  escaladoEn           DateTime?        @map("escalado_en")
  encajeEconomico      EncajeEconomico? @map("encaje_economico")
  rutaComercial        RutaComercial?   @map("ruta_comercial")
  sede                 String?
  guionVersion         String?          @map("guion_version")
  asesorLockId         String?          @map("asesor_lock_id")
  slaVenceEn           DateTime?        @map("sla_vence_en")
  cola                 String?
  creadoEn             DateTime         @default(now()) @map("creado_en")
  actualizadoEn        DateTime         @updatedAt @map("actualizado_en")
  mensajes             Mensaje[]
  eventosOperativos    EventoOperativo[]
  interacciones        Interaccion[]

  @@unique([canal, externalThreadId])
  @@index([oportunidadId])
  @@index([clienteId])
  @@index([estadoBot])
  @@index([encajeEconomico])
  @@index([rutaComercial])
  @@index([cola])
  @@index([asesorLockId])
  @@map("conversaciones")
}

model Mensaje {
  id                 String            @id @default(cuid())
  conversacionId     String            @map("conversacion_id")
  conversacion       Conversacion      @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  direccion          DireccionMensaje
  autor              AutorMensaje
  canal              Canal
  contenido          String
  externalMessageId  String?           @map("external_message_id")
  ruta               RutaOrquestador?
  consumeCupo        Boolean           @default(false) @map("consume_cupo")
  plantillaUtilityId String?           @map("plantilla_utility_id")
  creadoEn           DateTime          @default(now()) @map("creado_en")
  eventosOperativos  EventoOperativo[]
  interacciones      Interaccion[]
  adjuntos           AdjuntoMensaje[]

  @@unique([canal, externalMessageId])
  @@index([conversacionId, creadoEn])
  @@map("mensajes")
}

model AdjuntoMensaje {
  id              String   @id @default(cuid())
  mensajeId       String   @map("mensaje_id")
  mensaje         Mensaje  @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  assetId         String?  @map("asset_id")
  asset           Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  mimeType        String   @map("mime_type")
  nombreOriginal  String?  @map("nombre_original")
  storageKey      String?  @map("storage_key")
  bytes           Int?
  creadoEn        DateTime @default(now()) @map("creado_en")

  @@index([mensajeId])
  @@index([assetId])
  @@map("adjuntos_mensaje")
}

model EventoOperativo {
  id              String          @id @default(cuid())
  tipo            String
  actor           ActorOperativo
  payload         Json
  clienteId       String?         @map("cliente_id")
  cliente         Cliente?        @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  oportunidadId   String?         @map("oportunidad_id")
  oportunidad     Oportunidad?    @relation(fields: [oportunidadId], references: [id], onDelete: SetNull)
  conversacionId  String?         @map("conversacion_id")
  conversacion    Conversacion?   @relation(fields: [conversacionId], references: [id], onDelete: SetNull)
  mensajeId       String?         @map("mensaje_id")
  mensaje         Mensaje?        @relation(fields: [mensajeId], references: [id], onDelete: SetNull)
  sede            String?
  creadoEn        DateTime        @default(now()) @map("creado_en")
  interaccion     Interaccion?

  @@index([oportunidadId, creadoEn])
  @@index([conversacionId, creadoEn])
  @@index([clienteId, creadoEn])
  @@index([actor, creadoEn])
  @@map("eventos_operativos")
}

// ─── Conocimiento + assets multimodales ─────────────────────────────────────

model Asset {
  id                   String         @id @default(cuid())
  proposito            PropositoAsset
  tipoMaterial         TipoMaterial   @map("tipo_material")
  mimeType             String         @map("mime_type")
  nombreOriginal       String         @map("nombre_original")
  storageKey           String         @map("storage_key")
  storageBucket        String         @map("storage_bucket")
  checksum             String?
  bytes                Int
  duracionSec          Int?           @map("duracion_sec")
  anchoPx              Int?           @map("ancho_px")
  altoPx               Int?           @map("alto_px")
  pipelineEstado       PipelineEstado @default(pendiente) @map("pipeline_estado")
  pipelineErrorCode    String?        @map("pipeline_error_code")
  pipelineErrorDetalle String?        @map("pipeline_error_detalle")
  pipelineProgresoPct  Int?           @map("pipeline_progreso_pct")
  sedeId               String?        @map("sede_id")
  creadoEn             DateTime       @default(now()) @map("creado_en")
  actualizadoEn        DateTime       @updatedAt @map("actualizado_en")
  documentoFuente      DocumentoFuente?
  adjuntosMensaje      AdjuntoMensaje[]

  @@unique([storageBucket, storageKey])
  @@index([proposito, pipelineEstado])
  @@map("assets")
}

model DocumentoFuente {
  id                String              @id @default(cuid())
  titulo            String
  tipo              TipoDocumentoFuente
  sede              String?
  version           Int                 @default(1)
  estado            EstadoPublicacion   @default(borrador)
  publicadoEn       DateTime?           @map("publicado_en")
  nombreArchivoCita String              @map("nombre_archivo_cita")
  inventarioId      String?             @map("inventario_id")
  assetId           String              @unique @map("asset_id")
  asset             Asset               @relation(fields: [assetId], references: [id])
  tipoMaterial      TipoMaterial        @map("tipo_material")
  pipelineEstado    PipelineEstado      @default(pendiente) @map("pipeline_estado")
  creadoEn          DateTime            @default(now()) @map("creado_en")
  actualizadoEn     DateTime            @updatedAt @map("actualizado_en")
  fragmentos        FragmentoVectorial[]

  @@index([estado, pipelineEstado])
  @@index([sede])
  @@index([inventarioId])
  @@map("documentos_fuente")
}

/// Fragmento indexable. `embedding` (pgvector) y `tsv` (FTS) vía Unsupported + migración SQL.
model FragmentoVectorial {
  id                 String           @id @default(cuid())
  documentoFuenteId  String           @map("documento_fuente_id")
  documentoFuente    DocumentoFuente  @relation(fields: [documentoFuenteId], references: [id], onDelete: Cascade)
  documentoVersion   Int              @map("documento_version")
  texto              String
  orden              Int              @default(0)
  /// pgvector — dimensión alineada a OPENAI_EMBEDDING_DIMENSIONS (1536)
  embedding          Unsupported("vector")?
  /// Full-text search español
  tsv                Unsupported("tsvector")?
  activo             Boolean          @default(true)
  origenDerivacion   OrigenDerivacion @map("origen_derivacion")
  noRecuperablePrecio Boolean         @default(false) @map("no_recuperable_precio")
  tipoMaterial       TipoMaterial?    @map("tipo_material")
  pageOrSlide        Int?             @map("page_or_slide")
  tStartMs           Int?             @map("t_start_ms")
  tEndMs             Int?             @map("t_end_ms")
  sedeId             String?          @map("sede_id")
  tipoDocumento      TipoDocumentoFuente? @map("tipo_documento")
  creadoEn           DateTime         @default(now()) @map("creado_en")

  @@index([documentoFuenteId, documentoVersion, orden])
  @@index([activo, sedeId])
  @@index([origenDerivacion])
  @@map("fragmentos_vectoriales")
}
