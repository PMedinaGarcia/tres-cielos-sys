# Copiar a `.env` en la raíz. No commitear secretos reales.

NODE_ENV=development
APP_ENV=dev

# --- API (apps/api) ---
PORT=3011
API_PREFIX=
CORS_ORIGINS=http://localhost:3010
LOG_LEVEL=debug
QUEUE_DRIVER=inline

DATABASE_URL=postgresql://trescielos:localdev@localhost:5440/trescielos_dev?schema=public
REDIS_URL=redis://localhost:6390

JWT_SECRET=dev-only-change-me-not-for-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@trescielos.local
# No commitear la contraseña real. Mínimo 12, mayúscula, minúscula y dígito.
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# --- AI providers (docs/backend/07 §4) ---
# fake = smoke/CI sin keys; live exige OPENAI_API_KEY (COHERE_API_KEY opcional para rerank)
AI_PROVIDERS_MODE=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_MODEL_ORCHESTRATOR=gpt-4.1-mini
OPENAI_MODEL_GENERATOR=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MODEL_VISION=gpt-4.1-mini
OPENAI_WHISPER_MODEL=whisper-1
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
RERANK_THRESHOLD=0.85
RERANK_TOP_N=15
RERANK_TOP_K_LLM=4
AI_MAX_TOKENS_ORCHESTRATOR=1024
AI_MAX_TOKENS_GENERATOR=800
AI_MAX_INPUT_CHARS_RAG=12000
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
CUPO_MENSUAL_MENSAJES=1000
CUPO_AI_TOKENS_SOFT_LIMIT=
CUPO_AI_TOKENS_HARD_LIMIT=
STORAGE_PROVIDER=memory
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=tres-cielos-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
# memory = índice in-process (CI); prisma = pgvector + FTS (live)
RAG_STORE=memory
FETCH_CHANNEL_MEDIA=0

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3011
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=es-MX
# Railway: NEXT_PUBLIC_API_URL=/backend y API_INTERNAL_URL=http://api.railway.internal:3011
